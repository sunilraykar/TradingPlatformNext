APP_NAME=TradingPlatformNext
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=trading_platform_v2
MYSQL_USER=trading_app
MYSQL_PASSWORD=CHANGE_ME
MYSQL_POOL_SIZE=5

KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
KITE_REDIRECT_URL=http://127.0.0.1:8000/api/v1/kite/callback
KITE_TOKEN_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
KITE_AUTO_LOGIN_ENABLED=true

# Local session reset. Uses the configured timezone and runs once daily.
KITE_SESSION_RESET_ENABLED=true
KITE_SESSION_RESET_TIME=23:00
KITE_SESSION_RESET_TIMEZONE=Asia/Kolkata
